diff --git a/packages/benchmark/apps/ui-react/src/data.ts b/packages/benchmark/apps/ui-react/src/data.ts
index 2e220167..052b0f54 100644
--- a/packages/benchmark/apps/ui-react/src/data.ts
+++ b/packages/benchmark/apps/ui-react/src/data.ts
@@ -43,0 +44,26 @@ export function buildData(count = 1000): RowData[] {
+
+// Deterministic variant for the mount-create (autoRows) ladder; see
+// ../../shared/data.ts for rationale. mulberry32(42).
+export function buildDataSeeded(count: number): RowData[] {
+  let seed = 42 >>> 0;
+  const rand = () => {
+    seed = (seed + 0x6d2b79f5) >>> 0;
+    let t = seed;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+  const pick = (max: number) => Math.round(rand() * 1000) % max;
+  const data: RowData[] = [];
+  for (let i = 0; i < count; i++) {
+    data.push({
+      id: ID++,
+      label: adjectives[pick(adjectives.length)]
+        + ' '
+        + colours[pick(colours.length)]
+        + ' '
+        + nouns[pick(nouns.length)],
+    });
+  }
+  return data;
+}
