--- a/packages/benchmark/shared/data.ts
+++ b/packages/benchmark/shared/data.ts
@@ -46,3 +46,32 @@ export function buildData(count = 1000): RowData[] {
   }
   return data;
 }
+
+// Deterministic variant for the mount-create (autoRows) ladder: labels must be
+// byte-identical across builds and frameworks so first-screen bundles and wire
+// traffic stay comparable. mulberry32(42), same convention as the Octane app.
+export function buildDataSeeded(count: number): RowData[] {
+  let seed = 42 >>> 0;
+  const rand = () => {
+    seed = (seed + 0x6d2b79f5) >>> 0;
+    let t = seed;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+  const pick = (max: number) => Math.round(rand() * 1000) % max;
+  const data: RowData[] = [];
+  for (let i = 0; i < count; i++) {
+    data.push({
+      id: ID++,
+      label: shallowRef(
+        adjectives[pick(adjectives.length)]
+          + ' '
+          + colours[pick(colours.length)]
+          + ' '
+          + nouns[pick(nouns.length)],
+      ),
+    });
+  }
+  return data;
+}
