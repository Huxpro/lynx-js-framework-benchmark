{
  "name": "lynx-js-framework-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "A neutral benchmark infrastructure for JS frameworks on Lynx — dual-thread aware metrics, headless-web and native harnesses, and a public results site.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Huxpro/lynx-js-framework-benchmark"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --filter './entries/*' build",
    "bench": "node packages/runner/src/cli.mjs",
    "site:dev": "pnpm --filter site dev",
    "site:build": "pnpm --filter site build"
  }
}
